#!/bin/bash

"{{ .chezmoi.homeDir }}/.config/bspwm/monitor-setup.sh"

# 递归杀死进程树
function kill_tree() {
    local pid=$1
    for child in $(pgrep -P "$pid" 2>/dev/null); do
        kill_tree "$child"
    done
    kill -TERM "$pid" 2>/dev/null
}

# Execute a binary executable, restart it if it is running
function foo() {
    local sudo_flag=""
    if [ "$1" = "sudo" ]; then
        sudo_flag="sudo"
        shift
    fi

    # 杀掉已有实例的完整进程树
    for pid in $(pgrep -f "$1" 2>/dev/null); do
        kill_tree "$pid"
    done

    # 等待旧进程完全退出(最多 3 秒), 避免新旧实例并存
    local deadline=$(($(date +%s) + 3))
    while pgrep -f "$1" > /dev/null 2>&1 && [ "$(date +%s)" -lt "$deadline" ]; do
        sleep 0.1
    done
    # 超时仍未退出则强制 SIGKILL
    if pgrep -f "$1" > /dev/null 2>&1; then
        pgrep -f "$1" | xargs -r kill -KILL
    fi

    local cmd=()
    [ -n "$sudo_flag" ] && cmd+=(sudo)
    cmd+=("$1")
    nohup "${cmd[@]}" "${@:2}" >> "$HOME/.log/$(basename "$1").log" 2>&1 &
}


PATH="$HOME/.local/bin:$PATH"
