{{- $active := .opencode.model_profiles.active -}}
{{- $profile := index .opencode.model_profiles $active -}}
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "scout",
  "agent": {
    "build": {
      "disable": true
    }
  },
  "model": "{{ $profile.default_model }}",
  "provider": {
{{- range $pIndex, $provider := .opencode.providers }}
  {{- if $pIndex }},{{ end }}
    "{{ $provider.id }}": {
      "npm": "{{ $provider.type }}",
      "name": "{{ $provider.name }}",
      "options": {
        "baseURL": "{{ $provider.base_url }}",
        "apiKey": "{{ $provider.api_key }}"
      },
      "models": {
        {{- range $mIndex, $model := $provider.models }}
        {{- if $mIndex }},{{ end }}
        "{{ $model.id }}": {
          "name": "{{ $model.name }}"
          {{- if hasKey $model "limit" }},
          "limit": {{ $model.limit | toPrettyJson | indent 10 | trim }}
          {{- end }}
          {{- if hasKey $model "modalities" }},
          "modalities": {{ $model.modalities | toPrettyJson | indent 10 | trim }}
          {{- end }}
          {{- if hasKey $model "options" }},
          "options": {{ $model.options | toPrettyJson | indent 10 | trim }}
          {{- end }}
          {{- if hasKey $model "variants" }},
          "variants": {{ $model.variants | toPrettyJson | indent 10 | trim }}
          {{- end }}
        }
        {{- end }}
      }
    }
{{- end }}
  },
  "mcp": {
{{- if hasKey . "mcps" }}
{{- range $name, $cfg := .mcps }}
{{- $type := index $cfg "type" }}
{{- if not (or (eq $type "remote") (eq $type "local")) }}
{{- fail (printf "mcp '%s': type must be 'remote' or 'local', got '%s'" $name $type) }}
{{- end }}
{{- $profile := index $cfg "profile" }}
{{- if or (not $profile) (eq $profile $.machine_profile) }}
    "{{ $name }}": {
      "type": "{{ $type }}",
{{- if eq $type "remote" }}
      "url": "{{ index $cfg "url" }}",
{{- if index $cfg "headers" }}
      "headers": {
{{- range $k, $v := index $cfg "headers" }}
        "{{ $k }}": "{{ $v }}",
{{- end }}
      },
{{- end }}
{{- else }}
      "command": [{{ range $i, $v := index $cfg "command" }}{{ if $i }}, {{ end }}"{{ $v }}"{{ end }}],
{{- if index $cfg "environment" }}
      "environment": {
{{- range $k, $v := index $cfg "environment" }}
        "{{ $k }}": "{{ $v }}",
{{- end }}
      },
{{- end }}
{{- end }}
      "enabled": {{ index $cfg "enabled" }},
    },
{{- end }}
{{- end }}
{{- end }}
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "allow"
    },
    "edit": "allow",
    "write": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "ask",
    "list": "allow",
    "patch": "allow",
    "skill": "ask",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow"
  },
  "plugin": [
    "oh-my-openagent@latest"
  ]
}

{{- /* vim: set ft=go: */}}
