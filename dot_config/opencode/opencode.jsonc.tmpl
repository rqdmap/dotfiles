{{- $active := .opencode.model_profiles.active -}}
{{- $profile := index .opencode.model_profiles $active -}}

{{- /* ----------------------------------------
      Build MCP config
---------------------------------------- */ -}}
{{- $mcps := dict -}}
{{- if hasKey . "mcps" -}}
{{- range $name, $cfg := .mcps -}}
  {{- $type := index $cfg "type" -}}
  {{- if not (or (eq $type "remote") (eq $type "local")) -}}
    {{- fail (printf "mcp '%s': type must be 'remote' or 'local', got '%s'" $name $type) -}}
  {{- end -}}
  {{- $mcpProfile := index $cfg "profile" -}}
  {{- if or (not $mcpProfile) (eq $mcpProfile $.machine_profile) -}}
    {{- $entry := dict "type" $type "enabled" (index $cfg "enabled") -}}
    {{- if eq $type "remote" -}}
      {{- $_ := set $entry "url" (index $cfg "url") -}}
      {{- if index $cfg "headers" -}}
        {{- $_ := set $entry "headers" (index $cfg "headers") -}}
      {{- end -}}
    {{- else -}}
      {{- $_ := set $entry "command" (index $cfg "command") -}}
      {{- if index $cfg "environment" -}}
        {{- $_ := set $entry "environment" (index $cfg "environment") -}}
      {{- end -}}
    {{- end -}}
    {{- $_ := set $mcps $name $entry -}}
  {{- end -}}
{{- end -}}
{{- end -}}
{{- /* ----------------------------------------
      Build global tools config
---------------------------------------- */ -}}
{{- $tools := dict -}}
{{- if hasKey .opencode "tools" -}}
{{- range $cfg := .opencode.tools -}}
  {{- $toolProfile := index $cfg "profile" -}}
  {{- if or (not $toolProfile) (eq $toolProfile $.machine_profile) -}}
    {{- $_ := set $tools (index $cfg "pattern") (index $cfg "enabled") -}}
  {{- end -}}
{{- end -}}
{{- end -}}
{{- /* ----------------------------------------
      Build base agents config
---------------------------------------- */ -}}
{{- $agents := dict -}}
{{- if hasKey .opencode "agents" -}}
{{- range $name, $cfg := .opencode.agents -}}
  {{- $_ := set $agents $name $cfg -}}
{{- end -}}
{{- end -}}
{{- /* ----------------------------------------
      Merge agent_tools into agent.<name>.tools
---------------------------------------- */ -}}
{{- if hasKey .opencode "agent_tools" -}}
{{- range $cfg := .opencode.agent_tools -}}
  {{- $ruleProfile := index $cfg "profile" -}}
  {{- if or (not $ruleProfile) (eq $ruleProfile $.machine_profile) -}}
    {{- $agentName := index $cfg "agent" -}}
    {{- $agentEntry := dict -}}
    {{- if hasKey $agents $agentName -}}
      {{- $agentEntry = index $agents $agentName -}}
    {{- end -}}
    {{- $agentToolMap := dict -}}
    {{- if hasKey $agentEntry "tools" -}}
      {{- $agentToolMap = index $agentEntry "tools" -}}
    {{- end -}}
    {{- $_ := set $agentToolMap (index $cfg "pattern") (index $cfg "enabled") -}}
    {{- $_ := set $agentEntry "tools" $agentToolMap -}}
    {{- $_ := set $agents $agentName $agentEntry -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- /* ----------------------------------------
      Build plugins config
---------------------------------------- */ -}}
{{- $plugins := list -}}
{{- if hasKey .opencode "plugins" -}}
{{- $plugins = .opencode.plugins -}}
{{- end -}}

{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "experimental": {
    "disable_paste_summary": true
  },
  "default_agent": "scout",
  "model": "{{ $profile.default_model }}",
  "provider": {
{{- range $pIndex, $provider := .opencode.providers }}
  {{- if $pIndex }},{{ end }}
    "{{ $provider.id }}": {
      "npm": "{{ $provider.type }}",
      "name": "{{ $provider.name }}",
      "options": {
        "baseURL": "{{ $provider.base_url }}",
        "apiKey": "{{ $provider.api_key }}"
      },
      "models": {
        {{- range $mIndex, $model := $provider.models }}
        {{- if $mIndex }},{{ end }}
        "{{ $model.id }}": {
          "name": "{{ $model.name }}"
          {{- if hasKey $model "limit" }},
          "limit": {{ $model.limit | toPrettyJson | indent 10 | trim }}
          {{- end }}
          {{- if hasKey $model "modalities" }},
          "modalities": {{ $model.modalities | toPrettyJson | indent 10 | trim }}
          {{- end }}
          {{- if hasKey $model "options" }},
          "options": {{ $model.options | toPrettyJson | indent 10 | trim }}
          {{- end }}
          {{- if hasKey $model "variants" }},
          "variants": {{ $model.variants | toPrettyJson | indent 10 | trim }}
          {{- end }}
        }
        {{- end }}
      }
    }
{{- end }}
  },
  "agent": {{ $agents | toPrettyJson | indent 2 | trim }},
  "mcp": {{ $mcps | toPrettyJson | indent 2 | trim }},
  "tools": {{ $tools | toPrettyJson | indent 2 | trim }},
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "allow"
    },
    "edit": "allow",
    "write": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "ask",
    "list": "allow",
    "patch": "allow",
    "skill": "ask",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow"
  },
  "plugin": {{ $plugins | toPrettyJson | indent 2 | trim }}
}

{{- /* vim: set ft=go: */}}
