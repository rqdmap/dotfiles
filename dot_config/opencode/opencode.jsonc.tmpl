{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "tui": {
    "scroll_speed": 5
  },
  "provider": {
    "claude-proxy-standard": {
      "npm": "@ai-sdk/anthropic",
      "name": "C1 青铜背带裤",
      "options": {
        "baseURL": "{{ .provider.claude_proxy.base_url }}",
        "apiKey": "{{ .provider.claude_proxy.api_key }}"
      },
      "models": {
        "claude-sonnet-4-5-20250929": {
          "name": "claude-sonnet-4-5",
          "limit": {
              "context": 200000,
              "output": 65536
          }
        },
        "claude-opus-4-5-20251101": {
          "name": "claude-opus-4-5",
          "limit": {
              "context": 200000,
              "output": 65536
          }
        },
        "claude-haiku-4-5-20251001": {
          "name": "claude-haiku-4-5",
          "limit": {
              "context": 200000,
              "output": 65536
          }
        }
      }
    },
{{- if eq .machine_profile "work" }}
    "ducky": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ducky",
      "options": {
        "baseURL": "{{ .provider.ducky.base_url }}"
      },
      "models": {
        "ide-idealab/claude4.5-sonnet": {
          "name": "ide-idealab/claude4.5-sonnet"
        }
      }
    }
{{- end }}
  },
  "mcp": {
    "tavily-mcp": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={{ .mcp.tavily.token }}"
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer {{ .mcp.github.token }}"
      }
    },
    "desktop-commander": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@wonderwhy-er/desktop-commander@latest"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "firecrawl-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "environment": {
        "FIRECRAWL_API_KEY": "{{ .mcp.firecrawl.token }}"
      }
    }
  },
  "tools": {
    "bash": true,
    "edit": true,
    "write": true,
    "read": true,
    "grep": true,
    "glob": true,
    "list": true,
    "patch": true,
    "todowrite": true,
    "todoread": true,
    "webfetch": true
  },
  "permission": {
    "bash": {
      "git commit": "ask"
    }
  },
  "theme": "gruvbox",
  "keybinds": {
    "leader": "ctrl+x",
    "app_exit": "ctrl+c,<leader>q",
    "editor_open": "<leader>e",
    "theme_list": "none",
    "sidebar_toggle": "",
    "username_toggle": "none",
    "status_view": "<leader>s",
    "session_export": "",
    "session_new": "<leader>n",
    "session_list": "<leader>l",
    "session_timeline": "<leader>t",
    "session_share": "none",
    "session_unshare": "none",
    "session_interrupt": "escape",
    "session_compact": "",
    "session_child_cycle": "<leader>right",
    "session_child_cycle_reverse": "<leader>left",
    "session_parent": "<leader>up",
    "messages_page_up": "ctrl+b",
    "messages_page_down": "ctrl+f",
    "messages_half_page_up": "",
    "messages_half_page_down": "",
    "messages_first": "<leader>g",
    "messages_last": "<leader>G",
    "messages_next": "none",
    "messages_previous": "none",
    "messages_copy": "",
    "messages_undo": "",
    "messages_redo": "",
    "messages_last_user": "none",
    "messages_toggle_conceal": "",
    "model_list": "<leader>m,ctrl+m",
    "model_cycle_recent": "none",
    "model_cycle_recent_reverse": "none",
    "model_cycle_favorite": "tab",
    "model_cycle_favorite_reverse": "shift+tab",
    "variant_cycle": "none",
    "command_list": "ctrl+p",
    "agent_list": "<leader>a",
    "agent_cycle": "]",
    "agent_cycle_reverse": "[",
    "input_clear": "none",
    "input_paste": "none",
    "input_submit": "enter",
    "input_newline": "shift+enter,ctrl+j",
    "history_previous": "up",
    "history_next": "down",
    "terminal_suspend": "ctrl+z"
  }
}
