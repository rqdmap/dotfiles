{{- $active := .opencode.model_profiles.active -}}
{{- $profile := index .opencode.model_profiles $active -}}
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/refs/heads/dev/assets/oh-my-opencode.schema.json",
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": true,
    "planner_enabled": true,
    "replace_plan": true
  },
  "disabled_mcps": ["context7"],
  "agents": {
    // 默认编排者 - 负责规划、委派和执行复杂任务
    "sisyphus": {
      "model": "{{ index $profile "sisyphus" | default "" }}"
    },
    "hephaestus": {
      "model": "{{ index $profile "hephaestus" | default "" }}"
    },
    // 主协调器, 不直接执行, 通过委派协调
    "atlas": {
      "model": "{{ index $profile "atlas" | default "" }}"
    },
    // 代码实际的编写者 - 任务执行者
    "sisyphus-junior": {
      "model": "{{ index $profile "sisyphus_junior" | default "" }}"
    },
    // 架构顾问 - 专注于架构决策、代码审查和调试, 擅长逻辑推理和深度分析
    "oracle": {
      "model": "{{ index $profile "oracle" | default "" }}",
      "reasoningEffort": "high"
    },
    // 知识管理员 - 负责多仓库分析、文档查找, 提供基于证据的答案
    "librarian": {
      "model": "{{ index $profile "librarian" | default "" }}"
    },
    // 代码探索者 - 快速代码库探索和上下文搜索
    "explore": {
      "model": "{{ index $profile "explore" | default "" }}"
    },
    // 视觉专家 - 分析 PDF、图片、图表, 提取视觉信息, 支持多模态内容理解
    "multimodal-looker": {
      "disable": true
    },
    // 主规划器 - 通过迭代提问创建详细工作计划, 支持访谈模式, 负责任务的战略性规划
    "prometheus": {
      "model": "{{ index $profile "prometheus" | default "" }}"
    },
    // 计划顾问 - 预规划分析, 识别隐藏意图和模糊点, 在规划阶段提供专业建议
    "metis": {
      "model": "{{ index $profile "metis" | default "" }}"
    },
    // 计划审查员 - 验证计划的清晰度和完整性, 确保规划质量和可执行性
    "momus": {
      "model": "{{ index $profile "momus" | default "" }}",
      "reasoningEffort": "high"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "{{ index $profile "visual_engineering" | default "" }}" 
    },
    "ultrabrain": {
      "model": "{{ index $profile "ultrabrain" | default "" }}",
      "reasoningEffort": "high"
    },
    "deep": {
      "model": "{{ index $profile "deep" | default "" }}",
      "reasoningEffort": "medium"
    },
    "artistry": {
      "model": "{{ index $profile "artistry" | default "" }}" 
    },
    "quick": {
      "model": "{{ index $profile "quick" | default "" }}" 
    },
    "unspecified-low": {
      "model": "{{ index $profile "unspecified_low" | default "" }}" 
    },
    "unspecified-high": {
      "model": "{{ index $profile "unspecified_high" | default "" }}" 
    },
    "writing": {
      "model": "{{ index $profile "writing" | default "" }}" 
    }
  },
  "background_task": {
    "providerConcurrency": {
      "ikun-claude-2api": 3,
      "ikun-claude-2api-1m": 3,
      "idealab": 5,
      "modelscope": 5,
      "github-copilot": 10
    },
    "modelConcurrency": {
      "ikun-claude-2api-1m/claude-opus-4-6": 2,
      "idealab/gpt-5.2-1211-global": 2,
      "github-copilot/grok-code-fast-1": 20
    }
  }
}
