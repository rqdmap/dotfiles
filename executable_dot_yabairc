#!/usr/bin/env sh

# for this to work you must configure sudo such that
# it will be able to run the command without password
#
# see this wiki page for information:
#  - https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config window_animation_duration 0.0

# global settings
yabai -m config                                 \
    mouse_follows_focus          off            \
    focus_follows_mouse          off            \
    window_origin_display        default        \
    window_placement             second_child   \
    window_zoom_persist          on             \
    window_shadow                on             \
    window_animation_duration    0.0            \
    window_opacity_duration      0.0            \
    active_window_opacity        1.0            \
    normal_window_opacity        0.90           \
    window_opacity               off            \
    insert_feedback_color        0xffd75f5f     \
    split_ratio                  0.50           \
    split_type                   auto           \
    auto_balance                 off            \
    top_padding                  8             \
    bottom_padding               40             \
    left_padding                 12             \
    right_padding                12             \
    window_gap                   06             \
    layout                       bsp            \
    mouse_modifier               fn             \
    mouse_action1                move           \
    mouse_action2                resize         \
    mouse_drop_action            swap

pkill borders 2>/dev/null; borders \
  style=square \
  width=8.0 \
  hidpi=on \
  active_color=0xff00ff00 \
  inactive_color=0xff444444 \
  background_color=0x00000000 &

yabai -m rule --add app="choose" sticky=on manage=off
yabai -m rule --add app="系统设置" manage=off
yabai -m rule --add app="rogue" manage=off
yabai -m rule --add app="GIMP" manage=off
yabai -m rule --add app="阿里钉" manage=off
yabai -m rule --add app="阿里郎" manage=off
yabai -m rule --add app="Clash Verge" manage=off
yabai -m rule --add app="Python" manage=off
yabai -m rule --add app="IntelliJ IDEA" manage=off
yabai -m rule --add app="^Finder$" manage=off

# 记录每个 space 最近聚焦的 window id
yabai -m signal --add event=window_focused \
    action='SID=$(yabai -m query --windows --window "$YABAI_WINDOW_ID" 2>/dev/null | jq -r ".space // empty"); [ -n "$SID" ] && echo "$YABAI_WINDOW_ID" > "/tmp/yabai-last-win-$SID"'

echo "yabai configuration loaded.."
