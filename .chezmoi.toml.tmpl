{{- writeToStdout "\n========================================\n" -}}
{{- writeToStdout "  Machine Profile Selection\n" -}}
{{- writeToStdout "========================================\n" -}}
{{- writeToStdout "  Personal Machines:\n" -}}
{{- writeToStdout "    1. home   - ArchLinux Desktop (Tiling WM)\n" -}}
{{- writeToStdout "    2. work   - MacBook Pro Desktop (Tiling WM)\n" -}}
{{- writeToStdout "    3. macPie - MacBook Pro Server (Headless)\n" -}}
{{- writeToStdout "\n" -}}
{{- writeToStdout "  Generic Machines:\n" -}}
{{- writeToStdout "    4. vps    - Debian Server (Headless)\n" -}}
{{- writeToStdout "    5. linux  - ArchLinux Desktop (Tiling WM)\n" -}}
{{- writeToStdout "    6. mac    - MacOS Desktop (Tiling WM)\n" -}}
{{- writeToStdout "========================================\n\n" -}}

{{- $choice := promptIntOnce . "machine_profile_choice" "Enter your choice (1-6)" -}}

{{- $machine_profile := "" -}}
{{- if eq $choice 1 -}}
{{-   $machine_profile = "home" -}}
{{- else if eq $choice 2 -}}
{{-   $machine_profile = "work" -}}
{{- else if eq $choice 3 -}}
{{-   $machine_profile = "macpie" -}}
{{- else if eq $choice 4 -}}
{{-   $machine_profile = "vps" -}}
{{- else if eq $choice 5 -}}
{{-   $machine_profile = "linux" -}}
{{- else if eq $choice 6 -}}
{{-   $machine_profile = "mac" -}}
{{- else -}}
{{-   fail "Invalid choice. Please run 'chezmoi init' again and select 1-6." -}}
{{- end -}}

{{/* Derive system properties from machine profile */}}
{{- $profile := "personal" -}}
{{- $os := "unknown" -}}
{{- $interface := "headless" -}}
{{- $wm := "none" -}}

{{- if eq $machine_profile "home" -}}
{{-   $profile = "personal" -}}
{{-   $os = "arch" -}}
{{-   $interface = "gui" -}}
{{-   $wm = "tiling" -}}
{{- else if eq $machine_profile "work" -}}
{{-   $profile = "personal" -}}
{{-   $os = "macos" -}}
{{-   $interface = "gui" -}}
{{-   $wm = "tiling" -}}
{{- else if eq $machine_profile "macpie" -}}
{{-   $profile = "personal" -}}
{{-   $os = "arch" -}}
{{-   $interface = "headless" -}}
{{-   $wm = "none" -}}
{{- else if eq $machine_profile "vps" -}}
{{-   $profile = "generic" -}}
{{-   $os = "debian" -}}
{{-   $interface = "headless" -}}
{{-   $wm = "none" -}}
{{- else if eq $machine_profile "linux" -}}
{{-   $profile = "generic" -}}
{{-   $os = "arch" -}}
{{-   $interface = "gui" -}}
{{-   $wm = "tiling" -}}
{{- else if eq $machine_profile "mac" -}}
{{-   $profile = "generic" -}}
{{-   $os = "macos" -}}
{{-   $interface = "gui" -}}
{{-   $wm = "tiling" -}}
{{- end -}}

{{/* Convenience flags for templates */}}
{{- $is_personal := eq $profile "personal" -}}
{{- $is_generic := eq $profile "generic" -}}
{{- $is_arch := eq $os "arch" -}}
{{- $is_debian := eq $os "debian" -}}
{{- $is_macos := eq $os "macos" -}}
{{- $is_linux := or $is_arch $is_debian -}}
{{- $is_gui := eq $interface "gui" -}}
{{- $is_headless := eq $interface "headless" -}}
{{- $has_tiling_wm := eq $wm "tiling" -}}

[data]
  # Selected preset
  machine_profile = {{ $machine_profile | quote }}
  
  # Primary dimensions
  profile = {{ $profile | quote }}        # personal | generic
  os = {{ $os | quote }}                  # arch | debian | macos
  interface = {{ $interface | quote }}    # gui | headless
  wm = {{ $wm | quote }}                  # tiling | none
  
  # Convenience flags for templates
  is_personal = {{ $is_personal }}
  is_generic = {{ $is_generic }}
  is_arch = {{ $is_arch }}
  is_debian = {{ $is_debian }}
  is_macos = {{ $is_macos }}
  is_linux = {{ $is_linux }}
  is_gui = {{ $is_gui }}
  is_headless = {{ $is_headless }}
  has_tiling_wm = {{ $has_tiling_wm }}

[merge]
  command = "nvim"
  args = ["-d", "{{ `{{ .Destination }}` }}", "{{ `{{ .Source }}` }}", "{{ `{{ .Target }}` }}"]

# ========================================
# OpenCode 配置
# ========================================

# ----------------------------------------
# OpenCode Plugin 配置
# ----------------------------------------
# 这组插件会渲染到 opencode.jsonc 的 `plugin` 字段, 由 chezmoi 统一覆盖
[data.opencode]
  plugins = [
    "oh-my-openagent@latest",
  ]

[data.opencode.server]
  workspace_dirs = [ "~" ]
  base_port = 64601

# ----------------------------------------
# OpenCode Provider 配置
# ----------------------------------------
# 如果你主要通过 `/connect` 使用内置 provider, 这一段可以留空
# 下面保留 3 组常见示例: Anthropic, Google Gemini, OpenAI / OpenAI-compatible
# 使用方式: 复制对应块, 取消注释后替换 `base_url`, `api_key` 与 `models`
# 注意:
# - `id` 是 provider 唯一标识; 模型引用格式为 `provider_id/model_id`
# - `type` 对应 AI SDK provider 包
# - `name` 仅用于展示
# - `models` 支持 `limit`, `modalities`, `options`, `variants` 等字段

# 示例 1: Anthropic 或 Anthropic 代理
# [[data.opencode.providers]]
#   id = "anthropic-proxy"
#   type = "@ai-sdk/anthropic"
#   name = "Anthropic Proxy"
#   base_url = "https://api.example.com/v1"
#   api_key = "YOUR_ANTHROPIC_API_KEY"
#   models = [
#     { id = "claude-opus-4-6", name = "Opus 4.6", modalities = { input = ["text", "image"], output = ["text"] }, limit = { context = 200000, output = 32000 }, variants = { high = { thinking = { type = "adaptive" }, output_config = { effort = "high" } }, max = { thinking = { type = "adaptive" }, output_config = { effort = "max" } } } },
#     { id = "claude-sonnet-4-6", name = "Sonnet 4.6", modalities = { input = ["text", "image"], output = ["text"] }, limit = { context = 200000, output = 32000 }, variants = { high = { thinking = { type = "adaptive" }, output_config = { effort = "high" } }, max = { thinking = { type = "adaptive" }, output_config = { effort = "max" } } } },
#     { id = "claude-haiku-4-5-20251001", name = "Haiku 4.5", limit = { context = 200000, output = 65536 } },
#   ]

# 示例 2: Google Gemini 或 Gemini 代理
# [[data.opencode.providers]]
#   id = "google-proxy"
#   type = "@ai-sdk/google"
#   name = "Google Gemini Proxy"
#   base_url = "https://api.example.com/v1"
#   api_key = "YOUR_GOOGLE_API_KEY"
#   models = [
#     { id = "gemini-3.1-pro-preview", name = "Gemini 3.1 Pro Preview", modalities = { input = ["text", "image"], output = ["text"] }, limit = { context = 1048576, output = 65536 } },
#     { id = "gemini-3-flash-preview", name = "Gemini 3 Flash Preview", modalities = { input = ["text", "image"], output = ["text"] }, limit = { context = 1048576, output = 65536 } },
#   ]

# 示例 3: OpenAI 或 OpenAI-compatible 网关
# [[data.opencode.providers]]
#   id = "openai-proxy"
#   type = "@ai-sdk/openai"
#   name = "OpenAI Gateway"
#   base_url = "https://api.openai.com/v1"
#   api_key = "YOUR_OPENAI_API_KEY"
#   models = [
#     { id = "gpt-5.4", name = "GPT-5.4", modalities = { input = ["text", "image"], output = ["text"] }, limit = { context = 1050000, output = 128000 }, variants = { xhigh = { reasoningEffort = "xhigh", reasoningSummary = "auto", textVerbosity = "low", include = ["reasoning.encrypted_content"] } } },
#     { id = "gpt-5.4-mini", name = "GPT-5.4 Mini", modalities = { input = ["text", "image"], output = ["text"] }, limit = { context = 400000, input = 272000, output = 128000 } },
#   ]


# ----------------------------------------
# OpenCode Model Profile 配置
# ----------------------------------------
[data.opencode.model_profiles]
  active = "github"

[data.opencode.model_profiles.github]
  default_model = "openai/gpt-5.4"

[data.opencode.model_profiles.github.agents]
  # 默认编排者 - 负责规划、委派和执行复杂任务
  sisyphus = { model = "github-copilot/claude-opus-4.6", variant = "high" }

  # 深度执行者 - 代码实际实现主力
  hephaestus = { model = "openai/gpt-5.4", variant = "xhigh" }

  # 主协调器, 不直接执行, 通过委派协调
  atlas = { model = "github-copilot/claude-sonnet-4.6" }

  # 代码实际的编写者 - 任务执行者
  "sisyphus-junior" = { model = "github-copilot/claude-sonnet-4.6" }

  # 架构顾问 - 专注于架构决策、代码审查和调试
  oracle = { model = "openai/gpt-5.4", variant = "xhigh" }

  # 知识管理员 - 文档查找、多仓库分析、资料归纳
  librarian = { model = "github-copilot/gemini-3-flash-preview" }

  # 代码探索者 - 快速代码库探索和上下文搜索
  explore = { model = "openai/gpt-5.4-mini" }

  # 视觉专家
  "multimodal-looker" = { model = "github-copilot/gemini-3.1-pro-preview" }

  # 主规划器 - 负责战略规划和访谈式拆解
  prometheus = { model = "github-copilot/claude-opus-4.6", variant = "high" }

  # 计划顾问 - 预规划分析、识别模糊点
  metis = { model = "github-copilot/claude-opus-4.6", variant = "high" }

  # 计划审查员 - 审查方案质量、边界条件和漏洞
  momus = { model = "openai/gpt-5.4", variant = "xhigh" }

[data.opencode.model_profiles.github.categories]
  ultrabrain = { model = "openai/gpt-5.4", variant = "xhigh" }
  deep = { model = "openai/gpt-5.4", variant = "medium" }
  "visual-engineering" = { model = "github-copilot/gemini-3.1-pro-preview", variant = "high" }
  artistry = { model = "github-copilot/gemini-3.1-pro-preview", variant = "high" }
  "unspecified-low" = { model = "github-copilot/claude-sonnet-4.6" }
  "unspecified-high" = { model = "github-copilot/claude-opus-4.6", variant = "high" }
  writing = { model = "github-copilot/gemini-3-flash-preview" }
  quick = { model = "openai/gpt-5.4-mini" }


# ----------------------------------------
# OpenCode MCP 配置
# ----------------------------------------
# 使用方式: 复制对应块, 取消注释后替换名称, url, headers, command 与 environment
# 注意:
# - table 名字会成为最终 `mcp` 配置里的 key
# - `profile` 可选; 不写表示所有机器都生效
# - `enabled` 建议先设为 false, 确认联通后再开启

# 示例 1: 仅特定 profile 生效的 remote MCP (带鉴权 header)
# [data.mcps.my-remote-auth]
#   profile = "work"
#   type    = "remote"
#   url     = "https://mcp.example.com/mcp"
#   enabled = false
#   headers = { Authorization = "Bearer YOUR_TOKEN" }

# 示例 2: 所有机器通用的 remote MCP
# [data.mcps.my-remote-common]
#   type    = "remote"
#   url     = "https://mcp.public-example.com/mcp"
#   enabled = false

# 示例 3: 本地命令型 MCP (可带环境变量)
# [data.mcps.my-local-mcp]
#   type        = "local"
#   enabled     = false
#   command     = ["npx", "-y", "example-mcp-package"]
#   environment = { NODE_ENV = "production", MY_VAR = "some_value" }


# ----------------------------------------
# OpenCode agent 静态配置
# ----------------------------------------
[data.opencode.agents.build]
  disable = true

# 示例:
# [data.opencode.agents.oracle]
#   reasoningEffort = "high"


# ----------------------------------------
# OpenCode 全局 tools 配置
# ----------------------------------------
# 每条规则:
# - pattern: 对应 opencode 里的工具匹配模式
# - enabled: true / false
# - profile: 可选; 不写表示所有机器都生效

[[data.opencode.tools]]
  pattern = "context7_*"
  enabled = false

# 示例: 仅某个 profile 下关闭内部工具
# [[data.opencode.tools]]
#   profile = "work"
#   pattern = "example-internal_*"
#   enabled = false

# ----------------------------------------
# OpenCode agent 专属 tools 覆盖
# ----------------------------------------
# 用于给某个 agent 单独放开全局默认关闭的工具
# 示例 1: 仅某个 profile 下放开内部工具, 与全局禁用规则配合, 实现白名单能力
# [[data.opencode.agent_tools]]
#   agent   = "scout"
#   profile = "work"
#   pattern = "example-internal_*"
#   enabled = true

# 示例 2: 单独给 librarian 放开 context7
# [[data.opencode.agent_tools]]
#   agent   = "librarian"
#   pattern = "context7_*"
#   enabled = true

# ----------------------------------------
# MCP 工具 API Key 配置
# ----------------------------------------
# 这里保留可选环境变量槽位; 为空时不会被 zshenv 导出
[data.mcp-env]
  EXA_API_KEY = ""                      # 可选; 用于 Exa / web search MCP

# ========================================
# Trilium 配置
# ========================================
# 如果未使用 Trilium, 这一段可以保持注释状态
# [data.trilium]
#   url = "https://trilium.example.com"
#   token = "YOUR_TRILIUM_API_TOKEN"
#   parent_note_id = "root-note-id"

