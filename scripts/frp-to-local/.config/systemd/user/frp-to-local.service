[Unit]
Description=FRP Client Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
EnvironmentFile=%h/.config/frp-to-local/secret.env

# 获取服务器IP地址 - 这个仍需要shell来处理管道和环境变量
ExecStartPre=/bin/sh -c 'curl -s ${IP_SERVER} > %t/frpc-server-ip'

# 验证服务器可达性 - 这个可以简化
ExecStartPre=/bin/sh -c 'ping -c 1 -W 3 $(cat %t/frpc-server-ip) || exit 1'

# 设置环境变量并启动frpc
Environment=FRP_SERVER_ADDR=
ExecStart=/bin/sh -c 'export FRP_SERVER_ADDR=$(cat %t/frpc-server-ip) && exec frpc -c %h/.config/frp-to-local/frpc.toml'

# 清理临时文件
ExecStopPost=/bin/rm -f %t/frpc-server-ip

[Install]
WantedBy=default.target
