# ~/.local/share/chezmoi/.chezmoiignore

# Chezmoi Project Files
README.md

# Repo-internal build sources
tools/

# Archlinux System config
system

# ========================================
# GUI Configuration Exclusions
# ========================================

# Linux tiling WM configs (bspwm, i3, dwm, etc.)
{{ if not (and .has_tiling_wm .is_linux) }}
.config/bspwm
.config/polybar
.config/rofi
.config/picom
.config/sxhkd
.config/fontconfig
.fehbg
.config/wallpapers
.Xresources
{{ end }}

# macOS tiling stack
{{- $uses_macos_tiling_stack := and .has_tiling_wm .is_macos -}}
{{- $macos_tiling_backend := .macos_tiling_backend -}}
{{- $uses_aerospace := and $uses_macos_tiling_stack (eq $macos_tiling_backend "aerospace") -}}
{{- $uses_yabai := and $uses_macos_tiling_stack (eq $macos_tiling_backend "yabai") -}}
{{ if not $uses_macos_tiling_stack }}
.config/skhd
.config/sketchybar
.skhdrc
.local/bin/rebuild-hotkeys
{{ end }}

{{ if not $uses_aerospace }}
.config/aerospace
.config/sketchybar/plugins/aerospace_spaces.sh
{{ end }}

{{ if not $uses_yabai }}
.yabairc
.local/bin/yabai-spacectl
.config/sketchybar/plugins/space.sh
.config/sketchybar/plugins/space_windows.sh
{{ end }}

# Exclude GUI configs on headless systems
{{ if .is_headless }}
.config/fontconfig
.config/wezterm
.config/alacritty
{{ end }}


# ========================================
# System-Specific Exclusions
# ========================================

# Linux-only tools
{{ if not .is_linux }}
.config/ssh-tunnel
.config/systemd/
.local/bin/ssh-tunnel-manage
{{ end }}


# ========================================
# Profile-Specific Exclusions
# ========================================

# Personal tools
{{ if not .is_personal }}
.local/bin/blog
{{ end }}



# ========================================
# Archived(not in use) configurations
# ========================================

.config/joshuto
