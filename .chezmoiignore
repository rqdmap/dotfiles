# ~/.local/share/chezmoi/.chezmoiignore

{{- $BspwmLinuxMachines := list "home" "bspwm" -}}
{{- $MacOsMachines := list "work" "mac" -}}

# Linux-specific configuration
{{ if not (has .machine_type $BspwmLinuxMachines) }}
.config/bspwm
.config/polybar
.config/rofi
.config/picom
.config/sxhkd

.config/fontconfig
{{ end }}

# macOS-specific configuration
{{ if not (has .machine_type $MacOsMachines) }}
.config/sketchybar
.yabairc
.skhdrc
{{ end}}


# Archived(not in use) configurations
.config/joshuto


