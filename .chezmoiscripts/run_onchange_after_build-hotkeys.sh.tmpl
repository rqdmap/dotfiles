{{ if and .has_tiling_wm .is_macos -}}
#!/bin/bash
# config hash: {{ output "python3" "-c" "import hashlib, pathlib, sys; base=pathlib.Path(sys.argv[1]); files=sorted(p for p in base.iterdir() if p.is_file()); h=hashlib.sha256(); [h.update(p.name.encode() + b'\\0' + p.read_bytes() + b'\\0') for p in files]; print(h.hexdigest())" (joinPath .chezmoi.sourceDir "tools/karabiner-builder") }}
set -euo pipefail

SOURCE_DIR="{{ .chezmoi.sourceDir }}/tools/karabiner-builder"
KARABINER_DIR="{{ .chezmoi.homeDir }}/.config/karabiner/assets/complex_modifications"
SKHD_DIR="{{ .chezmoi.homeDir }}/.config/skhd"
SKHD_GENERATED_DIR="${SKHD_DIR}/generated"
SKHD_LOADER="${SKHD_DIR}/generated.skhdrc"

build_config() {
    uv run --with pyyaml python3 "${SOURCE_DIR}/build.py" \
        --write-outputs \
        --karabiner-dir "${KARABINER_DIR}" \
        --skhd-dir "${SKHD_GENERATED_DIR}" \
        "$@"
}

echo "==> Building macOS hotkey configs..."

mkdir -p "$KARABINER_DIR" "$SKHD_DIR" "$SKHD_GENERATED_DIR"

yaml_files=("${SOURCE_DIR}"/*.yaml)
for yaml in "${yaml_files[@]}"; do
    [ -f "$yaml" ] || continue
    echo "  Building $(basename "$yaml")..."
    build_config "$yaml"
done

tmp_loader="${SKHD_LOADER}.tmp"
{
    printf '# Auto-generated by chezmoi: do not edit.\n'
    for skhd in "${SKHD_GENERATED_DIR}"/*.skhdrc; do
        [ -f "$skhd" ] || continue
        [ "$skhd" = "$SKHD_LOADER" ] && continue
        printf '.load "%s"\n' "$skhd"
    done
} > "$tmp_loader"
mv "$tmp_loader" "$SKHD_LOADER"

if command -v skhd &>/dev/null && pgrep -q skhd; then
    skhd -r
    echo "  skhd reloaded"
fi

echo "==> Hotkey build done."
{{ end -}}
{{- /* vim: set ft=bash: */}}
