export TERM=xterm-256color

# 为journalctl-less设置标记
export SYSTEMD_LESS=FRXMK
export LESSCHARSET=utf-8

# Colorful less
export LESS_TERMCAP_mb=$(tput bold; tput setaf 2) # green
export LESS_TERMCAP_md=$(tput bold; tput setaf 6) # cyan
export LESS_TERMCAP_me=$(tput sgr0)
export LESS_TERMCAP_so=$(tput bold; tput setaf 3; tput setab 4) # yellow on blue
export LESS_TERMCAP_se=$(tput rmso; tput sgr0)
export LESS_TERMCAP_us=$(tput smul; tput bold; tput setaf 7) # white
export LESS_TERMCAP_ue=$(tput rmul; tput sgr0)
export LESS_TERMCAP_mr=$(tput rev)
export LESS_TERMCAP_mh=$(tput dim)
export LESS_TERMCAP_ZN=$(tput ssubm)
export LESS_TERMCAP_ZV=$(tput rsubm)
export LESS_TERMCAP_ZO=$(tput ssupm)
export LESS_TERMCAP_ZW=$(tput rsupm)
export GROFF_NO_SGR=1         # For Konsole and Gnome-terminal

# 24hours format
export LC_TIME=C.UTF-8

export VISUAL="nvim"
export EDITOR="nvim"

PATH=$PATH:$HOME/.local/bin
PATH=$PATH:$HOME/.cargo/bin
PATH=$PATH:$HOME/go/bin

# opencode
export OPENCODE_DISABLE_AUTOCOMPACT=true
{{- $mcpEnv := index . "mcp-env" -}}
{{- if ne $mcpEnv.EXA_API_KEY "" }}
export EXA_API_KEY="{{ $mcpEnv.EXA_API_KEY }}"
{{- end }}

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

{{ if eq .machine_profile "home" -}}
export {http,https,ftp,socks}_proxy="http://127.0.0.1:7890"
export no_proxy="localhost,127.0.0.0/8,10.0.0.0/8"
{{- else -}}
# export {http,https,ftp,socks}_proxy="http://127.0.0.1:7890"
# export no_proxy="localhost,127.0.0.0/8,10.0.0.0/8"
{{- end }}

{{ if eq .machine_profile "home" -}}
export CHROME_EXECUTABLE="google-chrome-stable"

# pnpm
export PNPM_HOME="/home/rqdmap/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end
{{- end }}

{{ if .is_macos -}}
export PATH=/opt/homebrew/bin/:$PATH
export PATH="$HOME/.npm-global/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"

{{- end }}

{{ if eq .machine_profile "work" -}}
# export JAVA_HOME="/opt/homebrew/opt/openjdk"
export JAVA_HOME="/Library/Java/JavaVirtualMachines/zulu-8.jdk/Contents/Home"
export PATH=$JAVA_HOME"/bin":$PATH

export M2_HOME=/Users/rqdmap/Applications/apache-maven-3.9.11
export PATH=$PATH:$M2_HOME/bin

export PATH="/opt/homebrew/opt/mysql@8.0/bin:$PATH"
export PATH="/opt/homebrew/Cellar/postgresql@15/15.14/bin:$PATH"

source <(~/.local/bin/astool completion zsh)
{{- end}}

{{- /* vim: set ft=zsh: */}}
