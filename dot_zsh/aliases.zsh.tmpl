function j() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}


# Python 虚拟环境管理
# alias mkvenv="python3 -m venv venv"
alias mkvenv="uv venv"
alias pip="uv pip"
alias pip3="uv pip"
function activate() {
    if [ -d ".venv" ]; then
        source .venv/bin/activate
    elif [ -d "venv" ]; then
        source venv/bin/activate
    else
        echo "未找到虚拟环境目录 (.venv 或 venv)"
        return 1
    fi
}

# git 字数检查
alias gitwa='git diff --word-diff=porcelain  | grep -e "^+[^+]" | wc -m | xargs'
alias gitwd='git diff --word-diff=porcelain  | grep -e "^-[^-]" | wc -m | xargs'
alias gitwdd='git diff --word-diff=porcelain | grep -e"^+[^+]" -e"^-[^-]"|sed -e's/.//'|sort|uniq -d|wc -m|xargs'
alias gitw='echo $(($(gitwa) - $(gitwd)))'

# Ctrl + W: 精细删除（遇到 / 会停下）
backward-kill-word() {
    local WORDCHARS='*?_-.[]~=&;!#$%^(){}<>'
    zle .backward-kill-word
}
zle -N backward-kill-word
bindkey '^W' backward-kill-word

# Ctrl + Backspace: 一口气删到空格为止, 默认的 Zsh 行为
backward-kill-whole-word() {
    local WORDCHARS='*?_-.[]~=/&;!#$%^(){}<>'
    zle .backward-kill-word
}
zle -N backward-kill-whole-word
# 绑定一个特殊的序列, 与 alacritty 配合
bindkey '^[^?' backward-kill-whole-word

{{/* MacOS */ -}}
{{ if .is_macos -}}
function nvm_enable() {
    export NVM_DIR="$HOME/.nvm"
    [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
    [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion
}
{{- end }}

