n() {
    "$@"
    local code=$?
    local cmd="$*"

    if [ ${#cmd} -gt 40 ]; then
        cmd="${cmd:0:37}..."
    fi

    if [ $code -eq 0 ]; then
        terminal-notifier -message "✅ 命令执行成功" -title "\$ $cmd" -sound Funk
    else
        terminal-notifier -message "❌ 命令执行失败" -title "\$ $cmd" -sound Basso
    fi
    return $code
}
{{- end }}

